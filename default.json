{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":automergeMinor"
  ],
  "minimumReleaseAge": "7 days",
  "packageRules": [
    {
      "matchDatasources": [
        "npm"
      ],
      "minimumReleaseAge": "7 days"
    },
    {
      "matchPackageNames": [
        "aiobotocore",
        "botocore"
      ],
      "groupName": "aiobotocore and botocore",
      "minimumGroupSize": 2
    },
    {
      "matchPackageNames": [
        "astral-sh/uv",
        "astral-sh/uv-pre-commit"
      ],
      "groupName": "astral-sh/uv"
    }
  ],
  "labels": [
    "dependencies"
  ],
  "vulnerabilityAlerts": {
    "labels": [
      "type:security"
    ],
    "minimumReleaseAge": null
  },
  "pre-commit": {
    "enabled": true
  },
  "lockFileMaintenance": {
    "enabled": true
  }
}
